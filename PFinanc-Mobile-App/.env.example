# Copy to .env (or run `npm run set-ip`) and set the backend URL.
# Use your PC's Wi-Fi IPv4 (ipconfig -> "Wireless LAN adapter WiFi"), NOT the vEthernet (WSL) 172.x address.
# For Android Emulator: http://10.0.2.2:5000
# For Physical Device:  http://<WiFi IPv4>:5000   (phone must be on the same network)
EXPO_PUBLIC_API_URL=http://<your-pc-ip>:5000
