# Copy to .env and edit. Never commit your real .env.

PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/pfinanc
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pfinanc
DB_USER=postgres
DB_PASSWORD=change_me

# Auth: REQUIRED in production. Generate one with:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Web frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3001

# --- AI features (all optional) ---
# You can paste your AI provider key in the app (AI Advisor > Settings); it is then stored in your own
# database. Alternatively set a server-wide default here:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
