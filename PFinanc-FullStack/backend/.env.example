# Copy to .env and edit. Never commit your real .env.

PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/pfinanc
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pfinanc
DB_USER=postgres
DB_PASSWORD=change_me

# Auth: REQUIRED in production. Generate one with:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Web frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3001

# Public HTTPS address of this API as seen from the internet (optional). Used to pre-fill the MCP connector
# URL shown in the app so Claude / ChatGPT can reach your server, e.g. https://finance.example.com
# PUBLIC_BASE_URL=

# --- AI features (all optional) ---
# You can paste your AI provider key in the app (AI Advisor > Settings); it is then stored in your own
# database. Alternatively set a server-wide default here:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Angel One SmartAPI (optional): live NSE/BSE stock & ETF prices and your demat holdings ---
# Create an app at https://smartapi.angelone.in to get an API key, and enable TOTP on your Angel One account
# (the TOTP *secret* is the text shown next to the QR code when you enable it).
# These are secrets: keep this file private (chmod 600), never commit it, and never put it in the mobile or web apps.
# Angel One does not offer mutual fund data through SmartAPI; funds keep using the free AMFI-based source.
# ANGELONE_API_KEY=
# ANGELONE_CLIENT_CODE=
# ANGELONE_PIN=
# ANGELONE_TOTP_SECRET=
# Only this household may use the broker login (default: the oldest household on the server).
# ANGELONE_HOUSEHOLD_ID=
# Refresh prices every N minutes (5 or more) during market hours; set ANGELONE_AUTO_REFRESH=false to refresh manually.
# ANGELONE_PRICE_REFRESH_MINUTES=15
# ANGELONE_AUTO_REFRESH=true
# Optional header values (Angel One does not check them for read-only calls):
# ANGELONE_LOCAL_IP=127.0.0.1
# ANGELONE_PUBLIC_IP=127.0.0.1
# ANGELONE_MAC_ADDRESS=00:00:00:00:00:00
