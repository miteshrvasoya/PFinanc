{
  "name": "pfinanc",
  "version": "1.0.0",
  "description": "Self-Hosted Personal & Family Finance Management Application",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed",
    "seed:dev": "npm --prefix backend run seed:dev",
    "seed:system": "npm --prefix backend run seed:system",
    "test": "npm --prefix backend test"
  },
  "keywords": [
    "finance",
    "family",
    "ledger",
    "personal-finance",
    "typescript",
    "postgres",
    "express",
    "react"
  ],
  "author": "Mitesh Vasoya",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}